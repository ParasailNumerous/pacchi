From 3bf86ba342cde002b0875c2e8c93150d9865e28c Mon Sep 17 00:00:00 2001
From: ParasailNumerous <305966967+ParasailNumerous@users.noreply.github.com>
Date: Thu, 17 Sep 2026 19:43:59 +0000
Subject: [PATCH 13/15] style: render icons via Material Symbols, vendor X as
 SVG

Replace fontello glyphs with ligature-based Material Symbols;
keep bird->X as inline SVG from SimpleIcons.
---
 src/views/renderutils.nim | 53 +++++++++++++++++++++++++++++++--------
 1 file changed, 42 insertions(+), 11 deletions(-)

diff --git a/src/views/renderutils.nim b/src/views/renderutils.nim
index deaf0d5..90de6f7 100644
--- a/src/views/renderutils.nim
+++ b/src/views/renderutils.nim
@@ -1,5 +1,5 @@
 # SPDX-License-Identifier: AGPL-3.0-only
-import strutils, strformat
+import strutils, strformat, tables
 import karax/[karaxdsl, vdom, vstyles]
 import ".."/[types, utils]
 
@@ -20,17 +20,48 @@ proc getMediumPic*(url: string): string =
     result &= mediumWebp
   result = getPicUrl(result)
 
+# Maps legacy fontello names to Material Symbols ligatures
+const iconMap = {
+  "group": "group", "views": "visibility", "heart": "favorite",
+  "quote": "format_quote", "comment": "chat_bubble", "play": "play_arrow",
+  "link": "link", "calendar": "calendar_month", "location": "location_on",
+  "picture": "photo", "lock": "lock", "down": "expand_more",
+  "retweet": "repeat", "search": "search", "pin": "push_pin",
+  "cog": "settings", "rss": "rss_feed", "ok": "check",
+  "attention-circled": "error", "download-alt": "download", "circle": "circle",
+  "info": "info", "user": "person"
+}.toTable
+
+const xSvg = """<svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>"""
+
 proc icon*(icon: string; label=""; title=""; class=""; href=""): VNode =
-  var c = "icon-" & icon
-  if class.len > 0: c = &"{c} {class}"
-  buildHtml(tdiv(class="icon-container")):
-    if href.len > 0:
-      a(class=c, title=title, `aria-label`=(if title.len > 0: title else: label), href=href)
-    else:
-      # a glyph is decorative unless it carries its own title
-      span(class=c, title=title, aria-hidden=(if title.len > 0: "false" else: "true"))
-    if label.len > 0:
-      text " " & label
+  let labelText = if title.len > 0: title elif label.len > 0: label else: ""
+  let isDecorative = labelText.len == 0
+  if icon == "bird":
+    # X logo has no Material equivalent; use vendored SVG
+    let svgWrap = &"""<span class="icon-svg-wrap{ (if class.len>0: " "&class else: "")}">{xSvg}</span>"""
+    buildHtml(tdiv(class="icon-container")):
+      if href.len > 0:
+        a(href=href, `aria-label`=labelText, aria-hidden=(if isDecorative: "true" else: "false")):
+          verbatim svgWrap
+      elif isDecorative:
+        span(aria-hidden="true"): verbatim svgWrap
+      else:
+        span(role="img", `aria-label`=labelText): verbatim svgWrap
+      if label.len > 0: text " " & label
+  else:
+    let ligature = iconMap.getOrDefault(icon, icon)
+    var c = "material-symbols-outlined"
+    if class.len > 0: c = &"{c} {class}"
+    buildHtml(tdiv(class="icon-container")):
+      if href.len > 0:
+        a(class=c, href=href, `aria-label`=labelText, aria-hidden=(if isDecorative: "true" else: "false")):
+          text ligature
+      elif isDecorative:
+        span(class=c, aria-hidden="true"): text ligature
+      else:
+        span(class=c, role="img", `aria-label`=labelText): text ligature
+      if label.len > 0: text " " & label
 
 template verifiedIcon*(user: User): untyped {.dirty.} =
   if user.verifiedType != VerifiedType.none:
-- 
