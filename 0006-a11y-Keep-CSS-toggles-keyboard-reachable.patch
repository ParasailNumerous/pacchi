From 5b55a5ec60d38c54622fdf49c0f334484e559299 Mon Sep 17 00:00:00 2001
From: ParasailNumerous <305966967+ParasailNumerous@users.noreply.github.com>
Date: Thu, 17 Sep 2026 18:55:08 +0000
Subject: [PATCH 06/12] a11y: Keep CSS toggles keyboard-reachable

The search-filter and photo-rail disclosures hid their checkbox with
`display: none`, removing it from the tab order. Hide it visually
instead and mirror the focus ring onto its label.
---
 src/sass/include/_mixins.css | 19 ++++++++++++++++++-
 src/sass/inputs.scss         |  5 +++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/sass/include/_mixins.css b/src/sass/include/_mixins.css
index 5fde51a..7ad2a8b 100644
--- a/src/sass/include/_mixins.css
+++ b/src/sass/include/_mixins.css
@@ -1,5 +1,17 @@
 @import '_variables';
 
+@mixin visually-hidden {
+    position: absolute;
+    clip-path: inset(50%);
+    overflow: hidden;
+    width: 1px;
+    height: 1px;
+    margin: -1px;
+    padding: 0;
+    border: 0;
+    white-space: nowrap;
+}
+
 @mixin panel($width, $max-width) {
     max-width: $max-width;
     margin: 0 auto;
@@ -73,7 +85,12 @@
 
 @mixin create-toggle($elem, $height) {
     ##{$elem}-toggle {
-        display: none;
+        @include visually-hidden;
+
+        &:focus-visible ~ label {
+            outline: 2px solid var(--accent);
+            outline-offset: 2px;
+        }
 
         &:checked ~ .#{$elem} {
             max-height: $height;
diff --git a/src/sass/inputs.scss b/src/sass/inputs.scss
index 2b6016f..c3beb52 100644
--- a/src/sass/inputs.scss
+++ b/src/sass/inputs.scss
@@ -158,6 +158,11 @@ input::-webkit-datetime-edit-year-field:focus {
   }
 }
 
+.checkbox-container input:focus-visible ~ .checkbox {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
 .pref-group {
   display: inline;
 }
-- 
