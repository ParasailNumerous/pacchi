From 92644062d38faa5676fe28efa004eb94cfb0f721 Mon Sep 17 00:00:00 2001
From: ParasailNumerous <305966967+ParasailNumerous@users.noreply.github.com>
Date: Thu, 17 Sep 2026 14:28:53 +0000
Subject: [PATCH 3/3] add Pacchi theme, set as default theme

---
 public/css/themes/pacchi.css | 422 +++++++++++++++++++++++++++++++++++
 src/prefs_impl.nim           |   2 +-
 2 files changed, 423 insertions(+), 1 deletion(-)
 create mode 100644 public/css/themes/pacchi.css

diff --git a/public/css/themes/pacchi.css b/public/css/themes/pacchi.css
new file mode 100644
index 0000000..2232eb7
--- /dev/null
+++ b/public/css/themes/pacchi.css
@@ -0,0 +1,422 @@
+body {
+    --pacchi-sys-color-background: #fff;
+    --pacchi-sys-color-error: #b3261e;
+    --pacchi-sys-color-error-container: #f9dedc;
+    --pacchi-sys-color-inverse-on-surface: #f2f2f2;
+    --pacchi-sys-color-inverse-primary: #a8c7fa;
+    --pacchi-sys-color-inverse-surface: #303030;
+    --pacchi-sys-color-on-background: #1f1f1f;
+    --pacchi-sys-color-on-error: #fff;
+    --pacchi-sys-color-on-error-container: #410e0b;
+    --pacchi-sys-color-on-primary: #fff;
+    --pacchi-sys-color-on-primary-container: #041e49;
+    --pacchi-sys-color-on-primary-fixed: #041e49;
+    --pacchi-sys-color-on-primary-fixed-variant: #0842a0;
+    --pacchi-sys-color-on-secondary: #fff;
+    --pacchi-sys-color-on-secondary-container: #001d35;
+    --pacchi-sys-color-on-secondary-fixed: #001d35;
+    --pacchi-sys-color-on-secondary-fixed-variant: #004a77;
+    --pacchi-sys-color-on-surface: #1f1f1f;
+    --pacchi-sys-color-on-surface-variant: #444746;
+    --pacchi-sys-color-on-tertiary: #fff;
+    --pacchi-sys-color-on-tertiary-container: #072711;
+    --pacchi-sys-color-on-tertiary-fixed: #072711;
+    --pacchi-sys-color-on-tertiary-fixed-variant: #0f5223;
+    --pacchi-sys-color-outline: #747775;
+    --pacchi-sys-color-outline-variant: #c4c7c5;
+    --pacchi-sys-color-primary: #0b57d0;
+    --pacchi-sys-color-primary-container: #d3e3fd;
+    --pacchi-sys-color-primary-fixed: #d3e3fd;
+    --pacchi-sys-color-primary-fixed-dim: #a8c7fa;
+    --pacchi-sys-color-scrim: #000;
+    --pacchi-sys-color-secondary: #00639b;
+    --pacchi-sys-color-secondary-container: #c2e7ff;
+    --pacchi-sys-color-secondary-fixed: #c2e7ff;
+    --pacchi-sys-color-secondary-fixed-dim: #7fcfff;
+    --pacchi-sys-color-shadow: #000;
+    --pacchi-sys-color-surface: #fff;
+    --pacchi-sys-color-surface-bright: #fff;
+    --pacchi-sys-color-surface-container: #f0f4f9;
+    --pacchi-sys-color-surface-container-high: #e9eef6;
+    --pacchi-sys-color-surface-container-highest: #dde3ea;
+    --pacchi-sys-color-surface-container-low: #f8fafd;
+    --pacchi-sys-color-surface-container-lowest: #fff;
+    --pacchi-sys-color-surface-dim: #d3dbe5;
+    --pacchi-sys-color-surface-tint: #6991d6;
+    --pacchi-sys-color-surface-variant: #e1e3e1;
+    --pacchi-sys-color-tertiary: #146c2e;
+    --pacchi-sys-color-tertiary-container: #c4eed0;
+    --pacchi-sys-color-tertiary-fixed: #c4eed0;
+    --pacchi-sys-color-tertiary-fixed-dim: #6dd58c;
+}
+
+@media (prefers-color-scheme: dark) {
+    body {
+        --pacchi-sys-color-background: #131314;
+        --pacchi-sys-color-error: #f2b8b5;
+        --pacchi-sys-color-error-container: #8c1d18;
+        --pacchi-sys-color-inverse-on-surface: #303030;
+        --pacchi-sys-color-inverse-primary: #0b57d0;
+        --pacchi-sys-color-inverse-surface: #e3e3e3;
+        --pacchi-sys-color-on-background: #e3e3e3;
+        --pacchi-sys-color-on-error: #601410;
+        --pacchi-sys-color-on-error-container: #f9dedc;
+        --pacchi-sys-color-on-primary: #062e6f;
+        --pacchi-sys-color-on-primary-container: #d3e3fd;
+        --pacchi-sys-color-on-primary-fixed: #041e49;
+        --pacchi-sys-color-on-primary-fixed-variant: #0842a0;
+        --pacchi-sys-color-on-secondary: #035;
+        --pacchi-sys-color-on-secondary-container: #c2e7ff;
+        --pacchi-sys-color-on-secondary-fixed: #001d35;
+        --pacchi-sys-color-on-secondary-fixed-variant: #004a77;
+        --pacchi-sys-color-on-surface: #e3e3e3;
+        --pacchi-sys-color-on-surface-variant: #c4c7c5;
+        --pacchi-sys-color-on-tertiary: #0a3818;
+        --pacchi-sys-color-on-tertiary-container: #c4eed0;
+        --pacchi-sys-color-on-tertiary-fixed: #072711;
+        --pacchi-sys-color-on-tertiary-fixed-variant: #0f5223;
+        --pacchi-sys-color-outline: #8e918f;
+        --pacchi-sys-color-outline-variant: #444746;
+        --pacchi-sys-color-primary: #a8c7fa;
+        --pacchi-sys-color-primary-container: #0842a0;
+        --pacchi-sys-color-primary-fixed: #d3e3fd;
+        --pacchi-sys-color-primary-fixed-dim: #a8c7fa;
+        --pacchi-sys-color-scrim: #000;
+        --pacchi-sys-color-secondary: #7fcfff;
+        --pacchi-sys-color-secondary-container: #004a77;
+        --pacchi-sys-color-secondary-fixed: #c2e7ff;
+        --pacchi-sys-color-secondary-fixed-dim: #7fcfff;
+        --pacchi-sys-color-shadow: #000;
+        --pacchi-sys-color-surface: #131314;
+        --pacchi-sys-color-surface-bright: #37393b;
+        --pacchi-sys-color-surface-container: #1e1f20;
+        --pacchi-sys-color-surface-container-high: #282a2c;
+        --pacchi-sys-color-surface-container-highest: #333537;
+        --pacchi-sys-color-surface-container-low: #1b1b1b;
+        --pacchi-sys-color-surface-container-lowest: #0e0e0e;
+        --pacchi-sys-color-surface-dim: #131314;
+        --pacchi-sys-color-surface-tint: #d1e1ff;
+        --pacchi-sys-color-surface-variant: #444746;
+        --pacchi-sys-color-tertiary: #6dd58c;
+        --pacchi-sys-color-tertiary-container: #0f5223;
+        --pacchi-sys-color-tertiary-fixed: #c4eed0;
+        --pacchi-sys-color-tertiary-fixed-dim: #6dd58c;
+    }
+}
+
+body {
+    --bg_color: var(--pacchi-sys-color-surface);
+    --fg_color: var(--pacchi-sys-color-on-surface);
+    --fg_faded: var(--pacchi-sys-color-on-surface-variant);
+    --fg_dark: var(--pacchi-sys-color-primary);
+    --fg_nav: var(--pacchi-sys-color-primary);
+
+    --bg_panel: var(--pacchi-sys-color-surface-container);
+    --bg_elements: var(--pacchi-sys-color-surface-container-low);
+    --bg_overlays: var(--pacchi-sys-color-surface-container);
+    --bg_hover: var(--pacchi-sys-color-surface-bright);
+
+    --grey: var(--pacchi-sys-color-outline);
+    --dark_grey: var(--pacchi-sys-color-outline-variant);
+    --darker_grey: var(--pacchi-sys-color-surface-container-low);
+    --darkest_grey: var(--pacchi-sys-color-surface-container-lowest);
+    --border_grey: var(--pacchi-sys-color-outline-variant);
+
+    --accent: var(--pacchi-sys-color-primary);
+    --accent_light: var(--pacchi-sys-color-primary-fixed);
+    --accent_dark: var(--pacchi-sys-color-primary-container);
+    --accent_border: var(--pacchi-sys-color-outline);
+
+    --play_button: var(--pacchi-sys-color-primary);
+    --play_button_hover: var(--pacchi-sys-color-primary-fixed-dim);
+
+    --more_replies_dots: var(--pacchi-sys-color-outline);
+    --error_red: var(--pacchi-sys-color-error-container);
+    --verified_blue: var(--pacchi-sys-color-secondary);
+    --icon_text: var(--pacchi-sys-color-on-surface);
+
+    --tab: var(--pacchi-sys-color-on-surface-variant);
+    --tab_selected: var(--pacchi-sys-color-primary);
+
+    --profile_stat: var(--pacchi-sys-color-on-surface);
+
+    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
+    accent-color: var(--pacchi-sys-color-primary);
+    color-scheme: light dark;
+    font-size: 1rem;
+}
+
+* {
+    outline: 0px solid transparent;
+    margin: 0;
+    text-decoration: none;
+
+    &:where(:focus-visible) {
+        outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, var(--pacchi-sys-color-secondary));
+        outline-offset: var(--focus-ring-offset, 0px);
+    }
+}
+
+input,
+button,
+select {
+    font-family: inherit;
+}
+
+input[type="text"],
+input[type="number"] {
+    --focus-ring-width: 2px;
+    --focus-ring-offset: -2px;
+    --focus-ring-color: var(--pacchi-sys-color-primary);
+}
+
+.search-bar,
+.search-bar-nav {
+    &>form {
+        padding: 4px;
+        border-radius: 100px;
+        margin: auto;
+        gap: 8px;
+        background-color: var(--pacchi-sys-color-surface-container);
+        box-shadow: none;
+
+        input {
+            font-size: 1rem;
+            min-width: 0;
+            background-color: var(--pacchi-sys-color-surface-container-lowest);
+            color: var(--fg_color);
+            border: 0;
+            border-radius: inherit;
+            padding: 12px 16px;
+            margin-right: 0;
+            height: unset;
+        }
+
+        button {
+            position: relative;
+            background-color: var(--pacchi-sys-color-secondary-container);
+            color: var(--pacchi-sys-color-on-secondary-container);
+            border-radius: inherit;
+            flex-shrink: 0;
+            width: 42px;
+            height: 42px;
+            padding: 0px 5px 1px 8px;
+
+            &::after {
+                content: "";
+                position: absolute;
+                top: 50%;
+                left: 50%;
+                transform: translate(-50%, -50%);
+                width: 24px;
+                height: 24px;
+                mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20height%3D%2224%22%20viewBox%3D%220%20-960%20960%20960%22%20width%3D%2224%22%20fill%3D%22%23e3e3e3%22%3E%3Cpath%20d%3D%22M784-120%20532-372q-30%2024-69%2038t-83%2014q-109%200-184.5-75.5T120-580t75.5-184.5T380-840t184.5%2075.5T640-580q0%2044-14%2083t-38%2069l252%20252zM380-400q75%200%20127.5-52.5T560-580t-52.5-127.5T380-760t-127.5%2052.5T200-580t52.5%20127.5T380-400%22%2F%3E%3C%2Fsvg%3E");
+                background: currentColor
+            }
+
+            .icon-search {
+                display: none;
+            }
+
+            .icon-search::before {
+                transform: scale(1.5);
+            }
+        }
+    }
+}
+
+.search-field {
+    flex-wrap: nowrap;
+    position: relative;
+
+    .pref-input {
+        margin: 0;
+        padding: 0;
+        height: auto;
+        flex-grow: 1;
+        margin-right: 8px;
+
+        input {
+            width: 100%;
+            border-radius: 100px;
+            font-size: 1rem;
+            min-width: 0;
+            background-color: var(--pacchi-sys-color-surface-container-lowest);
+            color: var(--fg_color);
+            border: 0;
+            padding: 12px 16px;
+            box-sizing: border-box;
+            margin-right: 0;
+            height: unset;
+        }
+    }
+
+    button {
+        width: 42px;
+        height: 42px;
+        flex-shrink: 0;
+        display: flex;
+        align-items: center;
+        justify-content: center;
+
+        .icon-container {
+            transform: scale(1.25);
+        }
+    }
+}
+
+.search-field #search-panel-toggle {
+    display: block;
+    opacity: 0;
+    width: 0;
+    height: 0;
+}
+
+.search-field #search-panel-toggle:checked~.search-panel {
+    display: block;
+}
+
+.search-field #search-panel-toggle:focus~label {
+    outline: 2px solid var(--pacchi-sys-color-secondary);
+}
+
+.search-panel {
+    width: 100%;
+    max-height: none;
+    display: none;
+    overflow: hidden;
+    transition: none;
+    flex-grow: 1;
+    font-weight: initial;
+    text-align: left;
+
+    position: absolute;
+}
+
+.timeline-item {
+    overflow-wrap: break-word;
+    border-left-width: 0;
+    min-width: 0;
+    padding: 0.75em;
+    display: flex;
+    position: relative;
+    background-color: var(--pacchi-sys-color-surface-container);
+    border-radius: 16px;
+
+    &>.tweet-link {
+        border-radius: inherit;
+    }
+}
+
+.timeline>div:not(:first-child) {
+    border-top: none;
+    margin-top: 4px;
+}
+
+button {
+    --focus-ring-offset: 2px;
+    background-color: transparent;
+    color: inherit;
+    border: 1px solid var(--pacchi-sys-color-outline);
+    padding: 10px 12px;
+    border-radius: 100px;
+    font-size: 1rem;
+}
+
+nav {
+    background-color: var(--pacchi-sys-color-surface-container);
+    box-shadow: none;
+    height: 56px;
+
+    a {
+        color: inherit;
+    }
+
+    .icon-container a {
+        display: block;
+        margin: 0;
+        width: 48px;
+        height: 100%;
+        border-radius: 50%;
+        --focus-ring-offset: -2px;
+
+        &::before {
+            transform: scale(1.5);
+            margin-inline-end: 1rem;
+        }
+
+        &:hover {
+            background: color-mix(in srgb, transparent, var(--pacchi-sys-color-on-surface) 12%)
+        }
+    }
+
+    .site-name {
+        font-size: 1rem;
+        width: 48px;
+        height: 48px;
+        border-radius: 50%;
+        --focus-ring-offset: -2px;
+        color: transparent !important;
+        position: relative;
+
+        &::after {
+            content: "";
+            mask-image: url(data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20height%3D%2224%22%20viewBox%3D%220%20-960%20960%20960%22%20width%3D%2224%22%20fill%3D%22%23e3e3e3%22%3E%3Cpath%20d%3D%22M160-120v-480l320-240%20320%20240v480H560v-280H400v280z%22%2F%3E%3C%2Fsvg%3E);
+            width: 24px;
+            height: 24px;
+            position: absolute;
+            left: 50%;
+            top: 50%;
+            transform: translate(-50%, -50%);
+            display: block;
+            background: var(--pacchi-sys-color-on-surface);
+        }
+
+        &:hover {
+            background: color-mix(in srgb, transparent, var(--pacchi-sys-color-on-surface) 12%)
+        }
+
+    }
+
+    .nav-item {
+        flex-wrap: nowrap;
+        flex: auto;
+        flex-shrink: 0;
+    }
+}
+
+.search-bar-nav>form {
+    background: transparent;
+    padding: 0;
+    border-bottom: none;
+
+    &:has(:focus) {
+        border-bottom: none;
+    }
+
+    button:focus-visible {
+        outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, var(--pacchi-sys-color-secondary));
+    }
+
+    button {
+        background-image: none;
+    }
+}
+
+.checkbox-container {
+    margin-bottom: 0;
+    padding: 10px 0;
+
+    input {
+        position: absolute;
+        opacity: 1;
+        cursor: pointer;
+        height: 16px;
+        width: 16px;
+        right: 0;
+    }
+
+    .checkbox {
+        display: none;
+    }
+}
\ No newline at end of file
diff --git a/src/prefs_impl.nim b/src/prefs_impl.nim
index 592ce87..29c4438 100644
--- a/src/prefs_impl.nim
+++ b/src/prefs_impl.nim
@@ -51,7 +51,7 @@ macro genPrefs*(prefDsl: untyped) =
 
 genPrefs:
   Display:
-    theme(select, "Nitter"):
+    theme(select, "Pacchi"):
       "Theme"
 
     infiniteScroll(checkbox, false):
-- 
2.55.0

