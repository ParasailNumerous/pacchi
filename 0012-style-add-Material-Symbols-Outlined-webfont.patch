From 8ee1be34b311a2588826db253ef0b4f88a167b92 Mon Sep 17 00:00:00 2001
From: ParasailNumerous <305966967+ParasailNumerous@users.noreply.github.com>
Date: Thu, 17 Sep 2026 19:43:53 +0000
Subject: [PATCH 12/15] style: add Material Symbols Outlined webfont

Self-hosted variable woff2 with font-display:block to avoid FOIT.
---
 public/css/material-symbols.css     |  27 +++++++++++++++++++++++++++
 public/fonts/material-symbols.woff2 | Bin 0 -> 3484144 bytes
 2 files changed, 27 insertions(+)
 create mode 100644 public/css/material-symbols.css
 create mode 100644 public/fonts/material-symbols.woff2

diff --git a/public/css/material-symbols.css b/public/css/material-symbols.css
new file mode 100644
index 0000000..9127d13
--- /dev/null
+++ b/public/css/material-symbols.css
@@ -0,0 +1,27 @@
+@font-face {
+  font-family: "Material Symbols Outlined";
+  font-style: normal;
+  font-weight: 100 700;
+  src: url("/fonts/material-symbols.woff2") format("woff2");
+  font-display: block;
+}
+.material-symbols-outlined {
+  font-family: "Material Symbols Outlined";
+  font-weight: normal;
+  font-style: normal;
+  font-size: 24px;
+  line-height: 1;
+  letter-spacing: normal;
+  text-transform: none;
+  display: inline-block;
+  white-space: nowrap;
+  word-wrap: normal;
+  direction: ltr;
+  -webkit-font-feature-settings: "liga";
+  -webkit-font-smoothing: antialiased;
+  font-variation-settings: "FILL" 0, "wght" 300, "GRAD" 0, "opsz" 24;
+  vertical-align: middle;
+}
+/* Sizing aligns with surrounding text; avoids layout shift */
+.icon-container .material-symbols-outlined { font-size: 1.2em; vertical-align: -0.15em; }
+.icon-container .icon-svg { width: 1em; height: 1em; vertical-align: -0.15em; fill: currentColor; }
